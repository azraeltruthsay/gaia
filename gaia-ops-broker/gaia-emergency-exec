#!/usr/bin/env python3
"""
gaia-emergency-exec — T0 break-glass wrapper. Runs ONE arbitrary shell
command as root, no allow-list. Installed root:root 0755 at
/usr/local/bin/gaia-emergency-exec; invoked via a sudoers NOPASSWD rule for
`azrael` only.

Still gated by the same session file gaia-ops-broker writes, but the DM
broker sends when requesting T0 is visually distinct ("EMERGENCY ROOT ACCESS
REQUESTED") so an approval here is never mistaken for routine T1 ops. This
script also refuses to run unless the session on disk was specifically
granted at tier T0 — a T1 approval does not unlock this wrapper.

Stdlib only: must run under the system Python, no venv.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

SESSION_FILE = Path(os.getenv("GAIA_OPS_SESSION_FILE", "/run/gaia-ops-broker/session.json"))
LOG_FILE = Path(os.getenv("GAIA_OPS_LOG_FILE", "/var/log/gaia-ops.log"))

TIER = "T0"


def log_line(outcome: str, detail: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} tier={TIER} outcome={outcome} {detail}\n")


def require_fresh_t0_session() -> None:
    try:
        data = json.loads(SESSION_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        log_line("REFUSED", "reason=no_session")
        print("No approval session found. Run gaia-ops-request --tier T0 first.", file=sys.stderr)
        sys.exit(3)

    if time.time() > data.get("expires_at", 0):
        log_line("REFUSED", "reason=session_expired")
        print("Approval session expired. Run gaia-ops-request --tier T0 again.", file=sys.stderr)
        sys.exit(3)

    if data.get("tier") != "T0":
        log_line("REFUSED", f"reason=wrong_tier granted={data.get('tier')}")
        print("The current approval session is not tier T0. Request T0 explicitly.", file=sys.stderr)
        sys.exit(3)


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: gaia-emergency-exec <shell command>", file=sys.stderr)
        return 2

    if os.geteuid() != 0:
        print("gaia-emergency-exec must run as root (via sudo).", file=sys.stderr)
        return 2

    require_fresh_t0_session()

    command = " ".join(sys.argv[1:])
    log_line("EXECUTING", f"command={command!r}")
    result = subprocess.run(["bash", "-c", command])
    log_line("DONE" if result.returncode == 0 else "FAILED", f"rc={result.returncode}")
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
